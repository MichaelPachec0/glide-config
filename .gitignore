# Live Glide/Firefox browser profile data (~72 MB, volatile sqlite/wal files).
# This is NOT part of the TypeScript config and must stay out of the flake source
# so `nix develop` only ever sees the small, stable config files.
/glide/

# Claude session memory scratch.
/.remember/

# JS dev dependencies — regenerated by the devShell's guarded `npm install`.
/node_modules/

# direnv layout dir (holds the cached dev-env profile + GC root).
/.direnv/

# Nix build outputs.
/result
/result-*
