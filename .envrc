# Auto-load the Nix dev shell (tsserver/LSP + ESLint + Prettier) for the Glide
# config. Launching neovim from this directory then activates typescript-tools
# (npm-gated) and the eslint LSP automatically.
#
# Works with plain direnv (no nix-direnv required). If you later install
# nix-direnv, the `use flake` branch is taken automatically and is faster (cached).

watch_file flake.nix flake.lock package.json package-lock.json

if has use_flake; then
  use flake
else
  # Materialize the dev environment. --profile keeps a GC root (so the shell's
  # store paths aren't garbage-collected) and caches the evaluated environment.
  eval "$(nix print-dev-env --profile "$(direnv_layout_dir)/flake-profile")"
  # Run the shellHook (guarded `npm install` + PATH) — print-dev-env exports it
  # but does not execute it. The install guard makes re-runs cheap/idempotent.
  eval "${shellHook:-}"
fi
